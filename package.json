{
  "name": "high-throughput-job-system",
  "version": "1.0.0",
  "description": "Event-driven job processing system using Redis and RabbitMQ",
  "license": "ISC",
  "author": "Manish",
  "type": "commonjs",
  "main": "api/src/server.ts",
  "scripts": {
    "dev:api": "tsx watch api/src/server.ts",
    "dev:worker": "tsx watch worker/src/index.ts",
    "start:api": "node dist/api/src/server.js",
    "start:worker": "node dist/worker/src/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/generate-events.ts",
    "bench": "k6 run benchmarks/naive-vs-queue.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
